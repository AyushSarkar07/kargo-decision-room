# Copy to .env.local and fill in. Never commit real values.
# With no Supabase variables the app runs in local DEMO mode (synthetic data, local file store).

# --- Supabase (live mode) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated emails allowed to sign in (also insert them into public.reviewers).
FOUNDER_EMAILS=founder@example.com

# --- Gemini (AI scoring) ---
# Without a key, scoring is SIMULATED (keyword rules) and labelled as such everywhere.
# Use a billed Gemini API project for real candidate data: on the free tier Google may use inputs to improve its models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Email (Resend, test delivery only) ---
# Without RESEND_API_KEY + EMAIL_FROM + EMAIL_TEST_ALLOWLIST, sends are SIMULATED and nothing leaves the app.
RESEND_API_KEY=
# A sender on a domain verified in Resend, or onboarding@resend.dev for Resend's sandbox.
EMAIL_FROM="Kargo Hiring <onboarding@resend.dev>"
# Only these addresses can ever receive mail. The first one receives every message whose
# candidate address is not on the list. Real candidate addresses must NOT be listed.
EMAIL_TEST_ALLOWLIST=your-test-inbox@example.com
# Only "test" is supported in this build.
EMAIL_DELIVERY_MODE=test
# Optional: signing secret for the Resend delivery webhook (POST /api/webhooks/resend).
RESEND_WEBHOOK_SECRET=

# --- Demo mode ---
# DEMO_DATA_DIR=.data
# Demo mode is refused on Vercel unless this is set (data would not persist there).
# ALLOW_DEMO_ON_DEPLOY=false
